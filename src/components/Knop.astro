---
interface Props {
  href?: string;
  soort?: 'vol' | 'lijn' | 'licht' | 'lijnlicht';
  /* Uitgeschakeld: de knop bestaat wel, maar heeft nog geen bestemming.
     Beter zichtbaar leeg dan een link die nergens heen gaat. */
  uit?: boolean;
  /* Opent in een nieuw tabblad. Voor PDF's: de bezoeker raakt de pagina
     niet kwijt terwijl hij het document doorleest. */
  extern?: boolean;
  class?: string;
}
const { href, soort = 'vol', uit = false, extern = false, class: klasse = '' } = Astro.props;
const Tag = uit ? 'button' : 'a';
const attrs = uit
  ? { type: 'button', disabled: true }
  : { href, ...(extern ? { target: '_blank', rel: 'noopener noreferrer' } : {}) };
---

<Tag class={`knop knop--${soort} ${uit ? 'knop--uit' : ''} ${klasse}`} {...attrs}>
  <span class="knop__tekst"><slot /></span>
  <svg class="knop__pijl" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M2.5 8h10M9 4.5 12.5 8 9 11.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</Tag>

<style>
  .knop {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    padding: 0.85em 1.5em;
    border-radius: var(--r-pil);
    font-family: var(--font-tekst);
    font-size: var(--t-klein);
    font-weight: 650;
    font-stretch: 96%;
    letter-spacing: 0.02em;
    text-decoration: none;
    line-height: 1;
    transition:
      background-color var(--duur-kort) var(--ease-uit),
      color var(--duur-kort) var(--ease-uit),
      border-color var(--duur-kort) var(--ease-uit);
  }
  .knop__pijl {
    width: 1em;
    height: 1em;
    flex: none;
    transition: transform var(--duur-kort) var(--ease-uit);
  }
  .knop:hover .knop__pijl { transform: translateX(0.2em); }

  .knop--vol {
    background: var(--knop-vol);
    color: var(--knop-vol-inkt);
    border: var(--lijn) solid var(--knop-vol);
  }
  .knop--vol:hover { background: var(--knop-vol-hover); border-color: var(--knop-vol-hover); }

  .knop--lijn {
    background: transparent;
    color: var(--op-kalk);
    border: var(--lijn) solid color-mix(in srgb, var(--op-kalk) 38%, transparent);
  }
  .knop--lijn:hover { border-color: var(--op-kalk); }

  .knop--licht {
    background: var(--knop-licht);
    color: var(--knop-licht-inkt);
    border: var(--lijn) solid var(--knop-licht);
  }
  .knop--licht:hover { background: var(--knop-licht-hover); border-color: var(--knop-licht-hover); }

  /* De lijnknop voor op donker: de tweede actie naast een lichte knop.
     De rand komt uit de tekstkleur van het vlak, niet uit kwastzwart. */
  .knop--lijnlicht {
    background: transparent;
    color: var(--op-veld);
    border: var(--lijn) solid color-mix(in srgb, var(--op-veld) 45%, transparent);
  }
  .knop--lijnlicht:hover { border-color: var(--op-veld); }

  .knop--uit {
    font: inherit;
    font-size: var(--t-klein);
    font-weight: 650;
    cursor: not-allowed;
    background: transparent;
    color: var(--op-veld);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--goud) 70%, transparent);
  }
  .knop--uit:hover { background: transparent; border-color: color-mix(in srgb, var(--goud) 70%, transparent); }
  .knop--uit .knop__pijl { opacity: 0.45; }
  .knop--uit:hover .knop__pijl { transform: none; }
</style>
