---
/* Een geschilderde regel: één kwasthaal, dikker in het midden waar de
   kwast vol zit, uitlopend aan het eind waar hij leegraakt. Vervangt de
   platte 2px-lijn overal waar het contract "kwastregel" belooft. */
interface Props { kleur?: string; class?: string }
const { kleur = 'currentColor', class: klasse = '' } = Astro.props;
---

<svg
  class={`kwastregel ${klasse}`}
  viewBox="0 0 1200 14"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill={kleur}
    d="M2,7.4 C60,5.2 118,4.1 186,3.6 C268,3.0 344,3.4 428,4.0
       C520,4.7 596,4.2 682,3.7 C772,3.2 858,3.9 944,4.6
       C1024,5.2 1108,5.0 1198,4.2 L1198,8.6
       C1108,9.6 1024,9.9 944,9.4 C858,8.9 772,9.4 682,9.9
       C596,10.3 520,10.7 428,10.1 C344,9.6 268,9.9 186,10.4
       C118,10.8 60,10.2 2,11.0 Z"
  />
</svg>

<style>
  .kwastregel {
    display: block;
    width: 100%;
    height: clamp(7px, 0.8vw, 11px);
    opacity: 0.72;
  }
</style>
