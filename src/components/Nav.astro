---
import Merk from './Merk.astro';
import Knop from './Knop.astro';
import KwastRand from './KwastRand.astro';
import { talen, taalCodes } from '../i18n/talen';

interface Props { t: any; taal: string }
const { t, taal } = Astro.props;
---

<header class="kop">
  <div class="kop__band">
    <div class="omhulsel kop__rij">
      <a href="#top" class="kop__merk" aria-label={t.merk.naam}>
        <Merk hoogte="2.1rem" kleur="var(--lak)" />
      </a>

      <nav class="kop__nav" aria-label={t.nav.sectiesLabel}>
        <ul class="kop__lijst">
          {t.nav.items.map((item) => (
            <li><a href={item.href} class="kop__link plaat">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="kop__rechts">
        <!-- De schakelaar toont alleen wat er is. Zolang er één taal was,
             stond hier niets; nu staan alle drie de talen naast elkaar. -->
        {taalCodes.length > 1 && (
          <nav class="kop__talen" aria-label={t.nav.taalLabel}>
            <ul>
              {taalCodes.map((code) => (
                <li>
                  {code === taal ? (
                    <span class="kop__taal kop__taal--nu plaat" aria-current="true">
                      {talen[code].label}
                    </span>
                  ) : (
                    <a class="kop__taal plaat" href={talen[code].pad} hreflang={talen[code].htmlLang} lang={talen[code].htmlLang}>
                      <span class="verborgen">{talen[code].naam}</span>
                      <span aria-hidden="true">{talen[code].label}</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )}
        <Knop href="#contact" soort="vol" class="kop__actie">{t.nav.actie}</Knop>
      </div>
    </div>
    <KwastRand kleur="var(--kalk)" positie="onder" />
  </div>
</header>

<style>
  .kop {
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .kop__band {
    position: relative;
    background: var(--kalk);
  }
  .kop__rij {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    padding-block: var(--s4);
  }
  .kop__merk {
    color: var(--op-kalk);
    text-decoration: none;
    flex: none;
  }

  .kop__lijst {
    display: flex;
    gap: clamp(var(--s4), 2.2vw, var(--s6));
  }
  .kop__link {
    color: var(--op-kalk-zacht);
    text-decoration: none;
    padding-block: var(--s2);
    border-bottom: var(--lijn) solid transparent;
    transition:
      color var(--duur-kort) var(--ease-uit),
      border-color var(--duur-kort) var(--ease-uit);
  }
  .kop__link:hover {
    color: var(--op-kalk);
    border-bottom-color: var(--lak-helder);
  }

  /* Onder 74rem past de rij niet meer naast elkaar: de links zakken
     onder het merk in plaats van in een uitklapmenu te verdwijnen.
     Vijf ankers verbergen achter een knop kost meer dan het oplevert.
     Het omslagpunt lag op 60rem toen er vier korte Nederlandse labels
     stonden. Er zijn nu vijf labels, een taalschakelaar, en in het
     Portugees zijn de labels langer ("O centro de formação"), dus de rij
     loopt eerder vol. Gemeten op de langste taal, niet op de kortste. */
  @media (max-width: 74rem) {
    .kop__rij {
      flex-wrap: wrap;
      row-gap: var(--s3);
      padding-block: var(--s3);
    }
    .kop__nav {
      order: 3;
      width: 100%;
    }
    .kop__lijst {
      flex-wrap: wrap;
      gap: var(--s3) var(--s5);
      padding-top: var(--s1);
      border-top: 1px solid color-mix(in srgb, var(--op-kalk) 16%, transparent);
    }
  }
  .kop__rechts {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex: none;
  }
  .kop__talen ul {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }
  /* Geen kaders en geen scheidingstekens: de huidige taal is de enige die
     vol staat, de andere twee zijn gedempt. Dat is genoeg signaal. */
  .kop__taal {
    color: var(--op-kalk-zacht);
    text-decoration: none;
    padding: var(--s1) var(--s2);
    opacity: 0.72;
    transition:
      color var(--duur-kort) var(--ease-uit),
      opacity var(--duur-kort) var(--ease-uit);
  }
  .kop__taal:hover { color: var(--op-kalk); opacity: 1; }
  .kop__taal--nu {
    color: var(--op-kalk);
    opacity: 1;
    border-bottom: var(--lijn) solid var(--lak-helder);
  }

  /* Doorgegeven aan een component, dus :global() onder de gescopete ouder. */
  @media (max-width: 30rem) {
    .kop__rij :global(.kop__actie) { padding: 0.7em 1.05em; }
  }
</style>
