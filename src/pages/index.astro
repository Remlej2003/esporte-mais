---
/* De Nederlandse startpagina staat op de wortel: nl is de standaardtaal en
   krijgt geen voorvoegsel. De andere talen lopen via src/pages/[taal]/. */
import Startpagina from '../layouts/Startpagina.astro';
import { talen, standaardTaal } from '../i18n/talen';
---

<Startpagina t={talen[standaardTaal].content} taal={standaardTaal} />
