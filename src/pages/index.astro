  .paneel__rol { color: var(--goud); margin-bottom: var(--s4); }
  .paneel__titel { font-size: var(--t-h3); margin-top: var(--s5); }
  .paneel__tekst { margin-top: var(--s3); color: var(--op-veld-zacht); }

  /* Het circuit onder beide panelen. */
  .lus__circuit { margin-top: var(--s5); }
