  }
  @keyframes kruip { to { stroke-dashoffset: -400; } }

  .lus__sluit {
    margin-top: var(--s5);
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-uitspraak);
    color: var(--goud);
  }

  /* ══ Het pad ═════════════════════════════════════════════ */

  .pad { padding-block: var(--sectie-vlak); }
  .pad__kop { font-size: var(--t-h2); max-width: 16ch; }

  .pad__spoor { margin-top: clamp(var(--s7), 5vw, var(--s9)); }
  .pad__lijn {
    display: block;
    width: 100%;
    height: clamp(14px, 1.7vw, 24px);
  }
  /* Ongelijke tussenafstanden: de stappen worden korter naar het eind,
     dus de vaart zit in de vorm en niet in nummers. */
  .pad__stations {
    display: grid;
    grid-template-columns: 39% 33% 28%;
    margin-top: var(--s2);
  }
  .station { padding-right: var(--s5); }
  .station__merk {
    display: block;
    width: 3px;
    height: var(--s5);
    background: var(--lak);
    margin-bottom: var(--s4);
