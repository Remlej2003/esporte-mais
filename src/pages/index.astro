  }
  .aanpak h2 { font-size: var(--t-h2); max-width: 12ch; }
  .aanpak__woord > .groot { margin-top: var(--s5); max-width: var(--maat); }
  .aanpak__subkop { font-size: var(--t-h3); margin-top: var(--s8); }
  .aanpak__subkop + p { margin-top: var(--s3); color: var(--op-kalk-zacht); }
  .aanpak__raster :global(.aanpak__foto) { position: sticky; top: 8rem; }

  /* Kopjes die eerder als sjabloonplaatje waren opgemaakt zonder ooit
