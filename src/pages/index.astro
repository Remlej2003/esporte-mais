    font-size: var(--t-klein);
    color: var(--op-kalk-zacht);
  }

  /* ══ Aanpak ══════════════════════════════════════════════ */

  .aanpak { background: var(--kalk-diep); }
  .aanpak__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
