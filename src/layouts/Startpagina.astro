---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Knop from '../components/Knop.astro';
import Foto from '../components/Foto.astro';
import Merk from '../components/Merk.astro';
import KwastRand from '../components/KwastRand.astro';
import Kwastregel from '../components/Kwastregel.astro';
import Tekst from '../components/Tekst.astro';

interface Props {
  /* Het contentbestand van deze taal. Dezelfde vorm voor nl, en en pt. */
  t: any;
  taal: string;
}
const { t, taal } = Astro.props;

import veldFoto from '../images/community-veld.jpg';
import hellingFoto from '../images/helling-omhoog.jpg';
import krattenFoto from '../images/kratten-toren.jpg';
import kindFoto from '../images/kind-begeleid.jpg';
import bandFoto from '../images/band-paal.jpg';
import terreinFoto from '../images/terrein.jpg';
import centrumTerrein from '../images/centrum-terrein.jpg';
import centrumVijver from '../images/centrum-vijver.jpg';
import centrumKring from '../images/centrum-kring.jpg';
import centrumGrasveld from '../images/centrum-grasveld.jpg';

/* De vier foto's van het opleidingscentrum, in de volgorde van
   `centrum.fotos` in het contentbestand. Twee rijen van twee, gespiegeld:
   breed naast smal, dan smal naast breed. `verhouding` is wat de foto in
   de rij krijgt; de rij deelt de breedte daar naar, zodat de twee foto's
   in een rij exact even hoog uitkomen (zie de CSS bij .centrum__rij). */
const centrumBeelden = [
  { src: centrumTerrein, verhouding: '4 / 3', vlek: 'var(--goud)' },
  { src: centrumVijver, verhouding: '8 / 9', vlek: 'var(--veld)' },
  { src: centrumKring, verhouding: '3 / 2', vlek: 'var(--veld)' },
  { src: centrumGrasveld, verhouding: '2000 / 922', vlek: 'var(--lak-helder)' },
];
const centrumFotos = t.centrum.fotos.map((f: any, i: number) => ({ ...f, ...centrumBeelden[i] }));
const centrumRijen = [centrumFotos.slice(0, 2), centrumFotos.slice(2, 4)];
---

<Base taal={taal} titel={t.meta.titel} omschrijving={t.meta.omschrijving}>
  <a href="#inhoud" class="overslaan">{t.nav.overslaan}</a>
  <Nav t={t} taal={taal} />

  <main id="inhoud">
    <!-- ── De kop op de muur ─────────────────────────────── -->
    <section id="top" class="hero">
      <div class="omhulsel hero__raster">
        <div class="hero__woord">
          <h1 class="hero__kop">{t.hero.kop}<em>{t.hero.kopCursief}</em></h1>
          <p class="hero__inleiding maat">{t.hero.inleiding}</p>
          <p class="hero__geloof maat">{t.hero.geloof}</p>

          <!-- De kwastregel met de actie erop. De uitleg staat er bewust
               bóven: een bestuurder die nog niet weet wat dit is, hoort
               niet eerst twee knoppen tegen te komen. -->
          <div class="hero__lijn">
            <Kwastregel kleur="var(--roet)" class="hero__kwast" />
            <div class="hero__acties">
              <Knop href="#contact" soort="vol">{t.hero.actie}</Knop>
              <Knop href="#aanpak" soort="lijn">{t.hero.actieTweede}</Knop>
            </div>
          </div>
        </div>
        <Foto
          src={hellingFoto}
          alt={t.hero.foto.alt}
          plaat={t.hero.foto.plaat}
          vorm="boog"
          verhouding="4 / 5"
          breedtes={[440, 700, 900]}
          sizes="(max-width: 62rem) 88vw, 32vw"
          class="hero__foto"
        />
      </div>
    </section>

    <!-- ── Waarom dit nú nodig is ────────────────────────── -->
    <section class="waarom">
      <div class="omhulsel">
        <div class="waarom__hoofd">
          <h2 class="waarom__kop">{t.waarom.kop}</h2>
          <p class="groot">{t.waarom.inleiding}</p>
        </div>

        <div class="waarom__onder">
          <div>
            <p class="waarom__lijstkop">{t.waarom.gevolgenKop}:</p>
            <ul class="waarom__lijst">
              {t.waarom.gevolgen.map((g) => <li class="waarom__gevolg">{g}</li>)}
            </ul>
          </div>
          <p class="keerpunt">{t.waarom.keerpunt}</p>
        </div>
      </div>
    </section>

    <!-- ── De missie ─────────────────────────────────────── -->
    <!-- Klasse- en contentnaam blijven `visie`: het bronmateriaal noemt dit
         zo en DESIGN.md documenteert het onder die naam. Op de site heet het
         Missie, op verzoek van de opdrachtgever. Het staat als eerste in het
         menu en dus ook als eerste na de probleemschets. -->
    <section id="missie" class="visie geverfd">
      <KwastRand kleur="var(--kalk-diep)" positie="boven" variant={3} />
      <div class="omhulsel visie__raster">
        <div class="visie__woord">
          <h2>{t.visie.kop}</h2>
          <p class="groot maat">{t.visie.inleiding}</p>
          <ul class="streeplijst">
            {t.visie.onderdelen.map((o) => <li>{o}</li>)}
          </ul>
          <p class="visie__slot maat">{t.visie.slot}</p>
        </div>
        <Foto
          src={terreinFoto}
          alt={t.visie.foto.alt}
          plaat={t.visie.foto.plaat}
          vorm="recht"
          vlek="var(--goud)"
          breedtes={[400, 660]}
          sizes="(max-width: 62rem) 88vw, 34vw"
          class="visie__foto"
        />
      </div>
      <KwastRand kleur="var(--kalk-diep)" positie="onder" variant={2} />
    </section>

    <!-- ── De lus: het scharnier van de pagina ───────────── -->
    <!-- Draagt het anker #aanpak: "Onze aanpak" en "Lees onze aanpak"
         horen hier te landen, bij jongeren leiden jongeren. -->
    <section id="aanpak" class="lus geverfd donker">
      <KwastRand kleur="var(--veld)" positie="boven" />
      <div class="omhulsel">
        <h2 class="lus__kop">{t.lus.kop}</h2>
        <p class="groot maat lus__inleiding">{t.lus.inleiding}</p>

        <!-- Eén zin over twee vakken: links wordt de jongere opgeleid,
             rechts wordt het kind begeleid. Twee identieke vakken, want
             het is één beweging. -->
        <div class="lus__kring">
          {t.lus.panelen.map((p, i) => (
            <article class="paneel">
              <KwastRand kleur="var(--veld-diep)" positie="boven" variant={i === 0 ? 1 : 2} />
              <Foto
                src={i === 0 ? krattenFoto : kindFoto}
                alt={p.foto.alt}
                plaat={p.foto.plaat}
                vorm="recht"
                vlek="var(--goud)"
                verhouding="1 / 1"
                breedtes={[380, 620]}
                sizes="(max-width: 54rem) 88vw, 40vw"
                class="paneel__foto"
              />
              <p class="paneel__bijschrift">{p.bijschrift}</p>
              <KwastRand kleur="var(--veld-diep)" positie="onder" variant={i === 0 ? 3 : 1} />
            </article>
          ))}
        </div>

        <!-- Het circuit: wat de ene kant uit gaat, komt aan de andere terug.
             Dat is de hele claim, dus het staat er ook echt als een rondgang. -->
        <div class="lus__circuit" data-lus>
          <svg viewBox="0 0 1200 130" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            <path
              class="lus__pad"
              d="M300 14 H 900 C 1010 14 1010 108 900 108 H 316"
              fill="none"
              stroke="var(--goud)"
              stroke-width="4"
              stroke-linecap="round"
            />
            <path
              d="M336 96 L312 108 L336 120"
              fill="none"
              stroke="var(--goud)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <p class="lus__sluit">{t.lus.sluit}</p>
        </div>
      </div>
      <KwastRand kleur="var(--veld)" positie="onder" />
    </section>

    <!-- ── Leren door te doen ────────────────────────────── -->
    <section id="methode" class="aanpak geverfd">
      <KwastRand kleur="var(--kalk-diep)" positie="boven" variant={2} />
      <div class="omhulsel aanpak__raster">
        <div class="aanpak__woord">
          <h2>{t.aanpak.kop}</h2>
          <ul class="etiketten">
            {t.aanpak.onderdelen.map((o) => <li class="etiket">{o}</li>)}
          </ul>

          <h3 class="aanpak__subkop">{t.aanpak.bewijsKop}</h3>
          <p class="maat"><Tekst delen={t.aanpak.bewijs} /></p>

          <h3 class="aanpak__subkop">{t.aanpak.uniekKop}</h3>
          <ul class="streeplijst">
            {t.aanpak.uniek.map((u) => <li>{u}</li>)}
          </ul>

          <p class="keerpunt keerpunt--klein">{t.aanpak.slot}</p>
        </div>
        <Foto
          src={bandFoto}
          alt={t.aanpak.foto.alt}
          plaat={t.aanpak.foto.plaat}
          vorm="boog"
          breedtes={[420, 700]}
          sizes="(max-width: 62rem) 88vw, 36vw"
          class="aanpak__foto"
        />
      </div>
      <KwastRand kleur="var(--kalk-diep)" positie="onder" variant={3} />
    </section>

    <!-- ── Het opleidingscentrum ─────────────────────────── -->
    <section id="opleidingscentrum" class="centrum">
      <div class="omhulsel">
        <div class="centrum__raster">
          <h2 class="centrum__kop">{t.centrum.kop}</h2>
          <div class="centrum__woord">
            <p class="groot">{t.centrum.inleiding}</p>
            {t.centrum.alineas.map((a) => <p class="centrum__alinea maat">{a}</p>)}
          </div>
        </div>

        <!-- Documentatie van de plek, dus rechte plaatjes en geen bogen. -->
        <div class="centrum__fotos">
          {centrumRijen.map((rij, r) => (
            <div class="centrum__rij">
              {rij.map((f, k) => (
                <Foto
                  src={f.src}
                  alt={f.alt}
                  plaat={f.plaat}
                  vorm="recht"
                  vlek={f.vlek}
                  verhouding={f.verhouding}
                  breedtes={[420, 760, 1100]}
                  sizes="(max-width: 54rem) 88vw, 46vw"
                  kwaliteit={64}
                  class={`centrum__foto centrum__foto--${r * 2 + k + 1}`}
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── De telling op de muur ─────────────────────────── -->
    <section id="impact" class="doelen geverfd donker">
      <KwastRand kleur="var(--lak)" positie="boven" />
      <div class="omhulsel">
        <div class="doelen__hoofd">
          <div class="doelen__titel">
            <h2 class="doelen__kop">{t.doelen.kop}</h2>
            <!-- Vijf jaar, vijf strepen. De THESIS zegt dat deze
                 gemeenschap haar eigen telling met de kwast bijhoudt;
                 dan moet er ook één streepje met de kwast staan. -->
            <svg class="doelen__turf" viewBox="0 0 108 62" aria-hidden="true" focusable="false">
              <path d="M8,7 C6.4,22 7.2,38 9,55" stroke="currentColor" stroke-width="5.2" stroke-linecap="round" fill="none" />
              <path d="M27,5 C25.8,21 26.6,39 28,54" stroke="currentColor" stroke-width="4.6" stroke-linecap="round" fill="none" />
              <path d="M46,8 C45.2,23 45.6,39 47,56" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none" />
              <path d="M65,4 C64.2,21 64.8,38 66,54" stroke="currentColor" stroke-width="4.4" stroke-linecap="round" fill="none" />
              <path d="M2,50 C22,41 52,22 78,6" stroke="currentColor" stroke-width="5.6" stroke-linecap="round" fill="none" />
            </svg>
          </div>
          <p class="doelen__waarschuwing">{t.doelen.waarschuwing}</p>
        </div>

        <ol class="telling">
          {t.doelen.lijst.map((d) => (
            <li class="tel">
              <span class="tel__getal cijfers">{d.getal}</span>
              <span class="tel__woord">
                <strong class="tel__eenheid">{d.eenheid}</strong>
                <span class="tel__tekst">
                  {Array.isArray(d.tekst) ? <Tekst delen={d.tekst} /> : d.tekst}
                </span>
              </span>
            </li>
          ))}
        </ol>

        <div class="doelen__voet">
          <h3 class="doelen__daarnaastkop">{t.doelen.daarnaastKop}</h3>
          <ul class="doelen__daarnaast">
            {t.doelen.daarnaast.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
      <KwastRand kleur="var(--lak)" positie="onder" />
    </section>

    <!-- ── De borden langs het veld ──────────────────────── -->
    <section id="partner" class="partner">
      <div class="omhulsel">
        <div class="partner__hoofd">
          <h2>{t.partner.kop}</h2>
          <p class="groot maat">{t.partner.inleiding}</p>
        </div>

        <h3 class="partner__bordenkop">{t.partner.bordenKop}</h3>
        <!-- Wat een sponsor in het echt koopt: een geschilderd bord langs
             de rand van het veld. Geen omrande kaarten maar verf op de
             muur, dus gekwaste randen en geen lijst eromheen. Van klein
             naar groot, in de kleuren van het partnerdocument waar de
             muur ze heeft: goud, groen, en menie voor het blauw. -->
        <ul class="borden">
          {t.partner.borden.map((b, i) => {
            /* Verf en inkt uit één bron, zodat een vierde bord niet stilletjes
               zonder kleur valt. */
            const lagen = [
              { verf: 'var(--goud)', inkt: 'var(--roet)' },
              { verf: 'var(--veld)', inkt: 'var(--op-veld)' },
              { verf: 'var(--lak)', inkt: 'var(--op-lak)' },
            ];
            const { verf, inkt } = lagen[i % lagen.length];
            return (
              <li class="bord" style={`--verf:${verf};--inkt:${inkt}`}>
                <KwastRand kleur={verf} positie="boven" variant={((i % 3) + 1) as 1 | 2 | 3} />
                <div class="bord__kop">
                  <h4 class="bord__naam">
                    {b.naam}
                    <em class="bord__werkwoord">{b.werkwoord}</em>
                  </h4>
                  <p class="bord__bedrag cijfers">{b.bedrag}</p>
                  <p class="bord__voor">{b.voor}</p>
                </div>
                <div class="bord__inhoud">
                  {b.basis && <p class="bord__basis">{b.basis}</p>}
                  <ul class="streeplijst bord__punten">
                    {b.punten.map((p) => <li>{Array.isArray(p) ? <Tekst delen={p} /> : p}</li>)}
                  </ul>
                </div>
                <KwastRand kleur={verf} positie="onder" variant={(((i + 1) % 3) + 1) as 1 | 2 | 3} />
              </li>
            );
          })}
        </ul>

        <div class="partner__overzicht">
          <p class="partner__noot">{t.partner.overzicht.tekst}</p>
          <Knop href={t.partner.overzicht.bestand} soort="lijn" extern={true}>{t.partner.overzicht.naam}</Knop>
        </div>

        <div class="partner__raster">
          <div class="partner__begin">
            <h3 class="partner__lijstkop">{t.partner.beginKop}</h3>
            <p class="maat partner__begintekst">{t.partner.begin}</p>
            <p class="partner__prijs cijfers">{t.partner.beginPrijs}</p>
            <p class="partner__prijsnoot">{t.partner.beginPrijsNoot}</p>
          </div>
          <div>
            <h3 class="partner__lijstkop">{t.partner.biedtKop}</h3>
            <ul class="streeplijst">
              {t.partner.biedt.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Niet vanaf de zijlijn ─────────────────────────── -->
    <section class="ervaring">
      <div class="omhulsel ervaring__raster">
        <Foto
          src={veldFoto}
          alt={t.ervaring.foto.alt}
          plaat={t.ervaring.foto.plaat}
          vorm="boog"
          vlek="var(--veld)"
          verhouding="4 / 3"
          breedtes={[450, 760]}
          sizes="(max-width: 62rem) 88vw, 42vw"
          class="ervaring__foto"
        />
        <div class="ervaring__woord">
          <h2>{t.ervaring.kop}</h2>
          <p class="groot">{t.ervaring.inleiding}</p>
          <ul class="streeplijst streeplijst--twee">
            {t.ervaring.vormen.map((v) => <li>{v}</li>)}
          </ul>
          <p class="keerpunt keerpunt--klein">{t.ervaring.slot}</p>
        </div>
      </div>
    </section>

    <!-- ── Doorlezen ─────────────────────────────────────── -->
    <!-- Wie meer wil dan deze pagina, hoort niet te hoeven mailen om
         eerst het verhaal te kunnen lezen: de korte versie staat online.
         Het volledige projectplan is op aanvraag. Staat bewust vlak voor
         de uitnodiging: dit is de laatste stap voor iemand contact opneemt. -->
    <section class="documenten">
      <div class="omhulsel documenten__raster">
        <div>
          <h2 class="documenten__kop">{t.documenten.kop}</h2>
          <p class="maat">{t.documenten.inleiding}</p>
        </div>
        <div class="documenten__acties">
          {t.documenten.items.map((item) =>
            item.bestand ? (
              <Knop href={item.bestand} soort="lijn" extern={true}>{item.naam}</Knop>
            ) : (
              <Knop href={item.mail} soort="lijn">{item.naam}</Knop>
            ),
          )}
        </div>
      </div>
    </section>

    <!-- ── Bouw mee ──────────────────────────────────────── -->
    <section id="contact" class="contact geverfd donker">
      <KwastRand kleur="var(--veld-diep)" positie="boven" />
      <div class="omhulsel contact__binnen">
        <h2 class="contact__kop">{t.contact.kop}</h2>
        <p class="groot maat">{t.contact.inleiding}</p>
        <p class="contact__uitnodiging maat">{t.contact.uitnodiging}</p>

        <div class="contact__acties">
          <Knop href={t.contact.actieMail} soort="licht">{t.contact.actie}</Knop>
          <Knop href={t.contact.actieWhatsapp} soort="lijnlicht" extern={true}>{t.contact.actieTweede}</Knop>
        </div>

        <dl class="contact__gegevens">
          {t.contact.gegevens.map((g) => (
            <div class="contact__gegeven">
              <dt class="plaat">{g.label}</dt>
              <dd><a href={g.href} {...(/^https?:/.test(g.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{g.tekst}</a></dd>
            </div>
          ))}
        </dl>
      </div>
      <KwastRand kleur="var(--veld-diep)" positie="onder" />
    </section>

    <!-- ── Het impressum ─────────────────────────────────── -->
    <footer class="voet">
      <div class="omhulsel voet__raster">
        <Merk hoogte="3rem" kleur="var(--lak)" toonCoordinaten={true} />
        <div class="voet__kolommen">
          <div>
            <p class="plaat voet__openkop">{t.voet.websitesKop}</p>
            <ul class="voet__lijst voet__lijst--links">
              {t.voet.websites.map((w) => (
                <li><a href={w.href} target="_blank" rel="noopener noreferrer">{w.tekst}</a></li>
              ))}
            </ul>
          </div>
          <div class="voet__open">
            <p class="plaat voet__openkop">{t.voet.openKop}</p>
            <ul class="voet__lijst">
              {t.voet.open.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
      <div class="omhulsel">
        <p class="plaat voet__noot">{t.voet.fotoNoot}</p>
      </div>
    </footer>
  </main>
</Base>

<style>
  /* ══ Gedeelde vormen op de muur ══════════════════════════ */

  section { position: relative; }

  .geverfd {
    /* Net meer dan de hoogte van de gekwaste rand, zodat die vrij ligt
       zonder dat er een gat ontstaat. */
    margin-block: clamp(1.5rem, 2.4vw, 2.25rem);
    padding-block: var(--sectie);
  }
  .lus { background: var(--veld); color: var(--op-veld); }
  .doelen { background: var(--lak); color: var(--op-lak); }
  .contact { background: var(--veld-diep); color: var(--op-veld); }

  .groot {
    font-size: var(--t-groot);
    line-height: 1.5;
    color: var(--op-kalk-zacht);
  }
  /* Alleen op de donkere vlakken. Eerder hing dit aan .geverfd, waardoor
     de aanpak- en visiesectie hun tekstkleur en streepjeskleur meekregen
     zodra ze een gekwaste rand kregen — één streepje in twee kleuren. */
  .donker .groot { color: inherit; opacity: 0.92; }

  /* De omslagzin: waar het stuk kantelt van probleem naar potentieel. */
  .keerpunt {
    font-family: var(--font-display);
    font-size: var(--t-keerpunt);
    line-height: 1.24;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin-top: var(--s8);
  }
  .keerpunt--klein {
    font-size: var(--t-uitspraak);
    margin-top: var(--s7);
  }

  /* Opsomming op geschilderde regels — geen kaarten. */
  .streeplijst { display: grid; gap: var(--s3); margin-top: var(--s4); }
  .streeplijst li {
    padding-block: var(--s3);
    padding-left: var(--s5);
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    position: relative;
  }
  .streeplijst li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--s3) + 0.62em);
    width: var(--s4);
    height: 2px;
    background: var(--lak-helder);
  }
  .donker .streeplijst li::before { background: var(--goud); }
  .streeplijst--twee { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0 var(--s6); }

  /* Handgeschilderde etiketten. */
  .etiketten {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s5);
  }
  .etiket {
    padding: 0.55em 1.15em;
    border: var(--lijn) solid color-mix(in srgb, var(--lak) 55%, transparent);
    border-radius: var(--r-pil);
    font-size: var(--t-klein);
    font-weight: 600;
    color: var(--op-kalk);
  }

  /* ══ Hero ════════════════════════════════════════════════ */

  .hero { padding-top: clamp(2rem, 4.5vw, 3.5rem); padding-bottom: var(--sectie-vlak); }
  .hero__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(var(--s6), 5vw, var(--s8));
    align-items: start;
  }
  .hero__kop {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    font-weight: 800;
    max-width: 13ch;
  }
  .hero__kop em {
    color: var(--lak);
    font-weight: 700;
  }
  /* De kwastregel loopt door achter de knoppen: de pil staat op de
     regel, zoals het contract het beschrijft. */
  .hero__lijn {
    position: relative;
    display: flex;
    align-items: center;
    margin-top: clamp(var(--s6), 3.5vw, var(--s8));
    min-height: 3.4rem;
  }
  /* Klassen die aan een component worden doorgegeven krijgen het
     scope-attribuut van de pagina niet; zonder :global() valt de regel
     stil weg. De ouder is wél gescopet, dus er lekt niets. */
  .hero__lijn :global(.hero__kwast) {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }
  .hero__acties {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
  /* De wand achter de knoppen, zodat de regel er niet doorheen loopt. */
  .hero__acties :global(.knop--lijn) { background: var(--kalk); }

  /* Onder 34rem passen de twee knoppen niet naast elkaar. Ze gaan
     onder elkaar en de haal loopt onder de primaire pil door, zodat
     "de pil staat op de regel" ook op een telefoon waar is — daar
     leest de meerderheid deze pagina. */
  @media (max-width: 34rem) {
    .hero__acties {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s4);
    }
    .hero__lijn :global(.hero__kwast) {
      top: 1.35rem;
      transform: none;
    }
  }

  .hero__inleiding {
    margin-top: clamp(var(--s5), 2.5vw, var(--s6));
    font-size: var(--t-groot);
    line-height: 1.55;
    color: var(--op-kalk-zacht);
  }
  /* De tweede alinea is de onderbouwing onder de belofte: lopende tekst,
     niet nog een inleiding op groot formaat. */
  .hero__geloof {
    margin-top: var(--s4);
    color: var(--op-kalk-zacht);
  }
  .hero__raster :global(.hero__foto) { margin-top: var(--s2); }

  /* ══ Waarom ══════════════════════════════════════════════ */

  .waarom { padding-block: var(--sectie-vlak); }
  .waarom__hoofd {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--s5), 4vw, var(--s8));
    align-items: end;
  }
  .waarom__kop { font-size: var(--t-h2); max-width: 11ch; }
  .waarom__onder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: start;
    margin-top: clamp(var(--s7), 5vw, var(--s9));
  }
  .waarom__lijstkop { font-size: var(--t-groot); color: var(--op-kalk-zacht); }
  .waarom__lijst {
    margin-top: var(--s4);
    border-top: var(--lijn) solid color-mix(in srgb, var(--op-kalk) 22%, transparent);
  }
  .waarom__gevolg {
    padding-block: var(--s3);
    border-bottom: 1px solid color-mix(in srgb, var(--op-kalk) 16%, transparent);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 500;
  }
  .waarom .keerpunt { margin-top: 0; }

  /* ══ Visie (de missie) ═══════════════════════════════════ */

  .visie { background: var(--kalk-diep); }
  .visie__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: start;
  }
  .visie h2 { font-size: var(--t-h2); }
  .visie__woord > .groot { margin-top: var(--s5); }
  .visie__slot {
    margin-top: var(--s7);
    font-family: var(--font-display);
    font-size: var(--t-uitspraak);
    line-height: 1.3;
  }

  /* ══ De lus ══════════════════════════════════════════════ */

  .lus__kop { font-size: var(--t-h2); max-width: 14ch; }
  .lus__inleiding { margin-top: var(--s5); }

  /* Coach en kind delen exact hetzelfde vak: zelfde rand, zelfde
     hoogte, zelfde beeldverhouding. Dat is de claim, dus het moet
     ook letterlijk zo op de muur staan. De zin loopt van het ene vak
     door in het andere. */
  .lus__kring {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto;
    align-items: stretch;
    gap: 0 clamp(var(--s4), 3vw, var(--s6));
    margin-top: clamp(var(--s7), 6vw, var(--s9));
  }
  /* Een subgrid legt foto en zin van beide vakken op dezelfde twee rijen.
     Het fotobijschrift is links langer dan rechts; zonder subgrid begint
     de zin rechts een regel hoger en loopt hij niet meer door van het
     ene vak in het andere. */
  .paneel {
    position: relative;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    align-content: start;
    padding: clamp(var(--s4), 2.2vw, var(--s6));
    background: var(--veld-diep);
  }
  .paneel__bijschrift {
    padding-top: var(--s5);
    font-size: var(--t-h3);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
  }

  /* Het circuit onder beide panelen. */
  .lus__circuit { margin-top: var(--s5); }
  .lus__circuit svg {
    width: 100%;
    height: auto;
    max-height: 8rem;
    overflow: visible;
  }
  .lus__pad {
    stroke-dasharray: 6 14;
  }
  .lus__circuit[data-zichtbaar] .lus__pad {
    animation: kruip 26s linear infinite;
  }
  @keyframes kruip { to { stroke-dashoffset: -400; } }

  .lus__sluit {
    margin-top: var(--s5);
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-uitspraak);
    color: var(--goud);
  }

  /* ══ Open punten ═════════════════════════════════════════ */

  /* Het mechanisme voor een gat in het materiaal: een gestippelde doos
     met role="note". Staat er nu nergens, maar hoort bij het systeem
     zodra er weer iets ontbreekt. */
  .openpunt {
    padding: var(--s3) var(--s4);
    border: 1px dashed color-mix(in srgb, var(--lak) 55%, transparent);
    font-size: var(--t-klein);
    color: var(--op-kalk-zacht);
  }

  /* ══ Aanpak ══════════════════════════════════════════════ */

  .aanpak { background: var(--kalk-diep); }
  .aanpak__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: start;
  }
  .aanpak h2 { font-size: var(--t-h2); max-width: 12ch; }
  .aanpak__subkop { font-size: var(--t-h3); margin-top: var(--s8); }
  .aanpak__subkop + p { margin-top: var(--s3); color: var(--op-kalk-zacht); }
  .aanpak__raster :global(.aanpak__foto) { position: sticky; top: 8rem; }

  /* ══ Het opleidingscentrum ═══════════════════════════════ */

  .centrum { padding-block: var(--sectie-vlak); }
  .centrum__raster {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: start;
  }
  .centrum__kop { font-size: var(--t-h2); max-width: 12ch; }
  .centrum__alinea { margin-top: var(--s5); }

  /* Twee rijen van twee. Elke foto groeit naar rato van zijn
     beeldverhouding (flex-grow = breedte gedeeld door hoogte, basis 0),
     dus de twee foto's in een rij komen exact even hoog uit en de
     bijschriften beginnen op dezelfde lijn. De getallen horen bij de
     `verhouding` die het template meegeeft: 4/3, 8/9, 3/2 en 2000/922. */
  .centrum__fotos {
    display: grid;
    gap: clamp(var(--s6), 4vw, var(--s8));
    margin-top: clamp(var(--s7), 5vw, var(--s9));
  }
  .centrum__rij {
    display: flex;
    align-items: flex-start;
    gap: clamp(var(--s5), 3vw, var(--s7));
  }
  .centrum__rij :global(.centrum__foto) { min-width: 0; }
  .centrum__rij :global(.centrum__foto--1) { flex: 1.3333 1 0; }
  .centrum__rij :global(.centrum__foto--2) { flex: 0.8889 1 0; }
  .centrum__rij :global(.centrum__foto--3) { flex: 1.5 1 0; }
  .centrum__rij :global(.centrum__foto--4) { flex: 2.1692 1 0; }

  /* Kopjes die eerder als sjabloonplaatje waren opgemaakt zonder ooit
     iets aan te duiden. Een kop hoort een kop te zijn. */
  .partner__bordenkop,
  .partner__lijstkop,
  .doelen__daarnaastkop {
    font-size: var(--t-h3);
    font-weight: 600;
  }
  .partner__bordenkop { margin-top: clamp(var(--s7), 5vw, var(--s9)); }
  .doelen__daarnaastkop { font-size: var(--t-h4); }

  /* ══ De telling ══════════════════════════════════════════ */

  .doelen__hoofd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s5);
  }
  .doelen__titel { display: flex; align-items: flex-end; gap: clamp(var(--s4), 2.5vw, var(--s6)); }
  .doelen__kop { font-size: var(--t-h2); max-width: 15ch; }
  .doelen__turf {
    flex: none;
    width: clamp(3.2rem, 5vw, 4.6rem);
    height: auto;
    color: var(--op-lak);
    opacity: 0.85;
    margin-bottom: 0.5em;
  }
  /* De belangrijkste waarheidsclaim op de pagina staat op leesformaat,
     niet in het kleinste type dat er is. */
  .doelen__waarschuwing {
    border: var(--lijn) solid color-mix(in srgb, var(--op-lak) 45%, transparent);
    padding: var(--s4) var(--s5);
    flex: 0 1 27rem;
    min-width: 17rem;
    font-size: var(--t-body);
    font-weight: 550;
    line-height: 1.55;
  }

  .telling { margin-top: clamp(var(--s7), 5vw, var(--s9)); }
  .tel {
    display: grid;
    grid-template-columns: minmax(max-content, 26%) minmax(0, 1fr);
    align-items: baseline;
    gap: clamp(var(--s5), 3vw, var(--s7));
    padding-block: clamp(var(--s4), 2vw, var(--s5));
    border-top: var(--lijn) solid color-mix(in srgb, var(--op-lak) 38%, transparent);
  }
  .tel:last-child { border-bottom: var(--lijn) solid color-mix(in srgb, var(--op-lak) 38%, transparent); }
  .tel__getal {
    font-family: var(--font-display);
    font-size: var(--t-cijfer);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .tel__woord { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.4em; }
  .tel__eenheid { font-size: var(--t-groot); font-weight: 650; }
  .tel__tekst { font-size: var(--t-groot); opacity: 0.86; }

  .doelen__voet { margin-top: clamp(var(--s6), 4vw, var(--s8)); }
  .doelen__daarnaast {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s5);
    margin-top: var(--s4);
    font-size: var(--t-groot);
  }
  .doelen__daarnaast li { display: flex; align-items: baseline; gap: var(--s3); }
  /* Geen liggend streepje als leesteken maar hetzelfde geschilderde
     staafje dat de rest van de pagina gebruikt. */
  .doelen__daarnaast li::before {
    content: '';
    width: var(--s4);
    height: 2px;
    background: currentColor;
    opacity: 0.6;
    flex: none;
    align-self: center;
  }

  /* ══ De borden ═══════════════════════════════════════════ */

  .partner { padding-block: var(--sectie-vlak); }
  .partner h2 { font-size: var(--t-h2); max-width: 12ch; }
  .partner__hoofd {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(var(--s5), 4vw, var(--s8));
    align-items: end;
  }

  .borden {
    display: grid;
    gap: clamp(var(--s6), 4vw, var(--s8));
    margin-top: var(--s6);
  }
  .bord {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: var(--s5) clamp(var(--s5), 4vw, var(--s8));
    padding: clamp(var(--s5), 3vw, var(--s7));
    background: var(--verf);
    color: var(--inkt);
  }
  .bord__naam {
    font-size: var(--t-bord);
    line-height: 1.05;
    font-weight: 700;
  }
  /* Het werkwoord bij de naam, cursief geschilderd zoals het slotwoord
     van de hoofdkop. Staat onder de naam, niet erboven: een kop krijgt
     geen opwarmer. */
  .bord__werkwoord {
    display: block;
    margin-top: var(--s2);
    font-size: var(--t-h3);
    font-weight: 600;
  }
  .bord__bedrag {
    margin-top: var(--s5);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
  }
  .bord__voor {
    margin-top: var(--s2);
    font-size: var(--t-klein);
    font-weight: 600;
    opacity: 0.86;
  }
  .bord__basis { font-weight: 650; }
  .bord__basis + .bord__punten { margin-top: var(--s3); }
  .bord__punten { margin-top: 0; gap: 0; }
  /* Op verf draagt het staafje de inkt van het bord, niet het oranje
     interactieaccent: dat verdwijnt op goud en op menie. */
  .bord__punten li::before { background: currentColor; opacity: 0.7; }
  .bord__punten li:first-child { border-top: 0; padding-top: 0; }
  .bord__punten li:first-child::before { top: 0.62em; }

  .partner__overzicht {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s6);
  }
  .partner__noot {
    font-size: var(--t-klein);
    color: var(--op-kalk-zacht);
  }

  .partner__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(var(--s6), 4vw, var(--s8));
    margin-top: clamp(var(--s7), 5vw, var(--s9));
    align-items: start;
  }
  .partner__begintekst { margin-top: var(--s4); color: var(--op-kalk-zacht); }
  .partner__prijs {
    margin-top: var(--s5);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
  }
  .partner__prijsnoot {
    margin-top: var(--s1);
    font-size: var(--t-klein);
    color: var(--op-kalk-zacht);
  }
  @media (max-width: 54rem) {
    .partner__raster { grid-template-columns: minmax(0, 1fr); }
  }

  /* ══ Ervaring ════════════════════════════════════════════ */

  .ervaring { padding-block: var(--sectie-vlak); }
  .ervaring__raster {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: center;
  }
  .ervaring h2 { font-size: var(--t-h2); max-width: 11ch; }
  .ervaring__woord > .groot { margin-top: var(--s5); max-width: var(--maat); }

  /* ══ Doorlezen ═══════════════════════════════════════════ */

  .documenten { padding-block: var(--sectie-vlak); }
  .documenten__raster {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(var(--s6), 5vw, var(--s9));
    align-items: start;
  }
  .documenten__kop { font-size: var(--t-h2); max-width: 12ch; margin-bottom: var(--s5); }
  .documenten__acties {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s4);
  }

  /* ══ Contact ═════════════════════════════════════════════ */

  .contact__binnen { max-width: 52rem; }
  .contact__kop { font-size: var(--t-h2); }
  .contact__binnen > .groot { margin-top: var(--s5); }
  .contact__uitnodiging {
    margin-top: var(--s5);
    font-size: var(--t-groot);
    color: var(--goud);
  }
  .contact__acties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s7);
  }
  /* De gegevens zelf, voor wie liever overtypt of kopieert dan klikt. */
  .contact__gegevens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s8);
    margin-top: var(--s6);
  }
  .contact__gegeven dt { color: var(--goud); }
  .contact__gegeven dd {
    margin-top: var(--s1);
    font-size: var(--t-groot);
  }

  /* ══ Voet ════════════════════════════════════════════════ */

  .voet { padding-block: var(--s8) var(--s7); }
  .voet__raster {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(var(--s6), 6vw, var(--s10));
    align-items: start;
    padding-top: var(--s7);
    border-top: var(--lijn-zwaar) solid var(--lak);
  }
  .voet__kolommen {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--s6) clamp(var(--s6), 4vw, var(--s8));
  }
  .voet__openkop { color: var(--lak); }
  .voet__lijst {
    margin-top: var(--s4);
    display: grid;
    gap: var(--s2);
    font-size: var(--t-klein);
    color: var(--op-kalk-zacht);
  }
  .voet__lijst li { padding-left: var(--s5); position: relative; }
  .voet__lijst li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: var(--s3);
    height: 2px;
    background: currentColor;
    opacity: 0.5;
  }
  .voet__lijst--links a { color: var(--op-kalk); }
  .voet__noot { margin-top: var(--s7); color: var(--op-kalk-zacht); opacity: 0.7; }

  /* ══ Smallere schermen ═══════════════════════════════════ */

  @media (max-width: 62rem) {
    .hero__raster,
    .waarom__hoofd,
    .waarom__onder,
    .aanpak__raster,
    .ervaring__raster,
    .visie__raster,
    .partner__hoofd,
    .centrum__raster,
    .documenten__raster,
    .voet__raster { grid-template-columns: minmax(0, 1fr); }

    .hero__kop { max-width: 16ch; }
    .aanpak__raster :global(.aanpak__foto) { position: static; }
    .ervaring__raster :global(.ervaring__foto) { order: 2; }
    .bord { grid-template-columns: minmax(0, 1fr); gap: var(--s5); }
    .waarom .keerpunt { margin-top: var(--s6); }
  }

  @media (max-width: 54rem) {
    /* Op één kolom moet de subgrid los: twee vakken die allebei twee
       rijen overspannen, belanden anders over elkaar. */
    .lus__kring {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--s5);
    }
    .paneel {
      grid-row: auto;
      grid-template-rows: auto;
    }
    /* Op één kolom is de rondgang een pijl terug omhoog. */
    .lus__circuit svg { max-height: 5rem; }
    .tel { grid-template-columns: minmax(0, 1fr); gap: var(--s2); }

    /* De fotorijen stapelen: twee foto's naast elkaar worden op een
       telefoon postzegels. Onder elkaar houdt elke foto zijn verhouding. */
    .centrum__rij { flex-direction: column; gap: clamp(var(--s6), 4vw, var(--s8)); }
    .centrum__rij :global(.centrum__foto) { flex: none; width: 100%; }

    .voet__kolommen { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  // Eén geregisseerd moment: de lus gaat lopen zodra je hem ziet.
  // Verder beweegt er niets bij het scrollen.
  const kring = document.querySelector('[data-lus]');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (kring && !stil && 'IntersectionObserver' in window) {
    const kijker = new IntersectionObserver(
      (regels) => {
        for (const regel of regels) {
          if (regel.isIntersecting) {
            regel.target.setAttribute('data-zichtbaar', '');
            kijker.disconnect();
          }
        }
      },
      { threshold: 0.25 }
    );
    kijker.observe(kring);
  }
</script>
