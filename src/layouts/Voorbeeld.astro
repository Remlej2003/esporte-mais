---
/* Stijlvoorbeeld voor de opdrachtgever: dezelfde inhoud als de startpagina,
   in de vormtaal van onnoraadsen.nl (Bebas Neue, Montserrat, goud, haarlijnen,
   genummerde kaarten). Twee thema's:
   - `licht`: crème en wit, goud als accent, salie als tweede kleur.
   - `onno`: volledig de stijl van onnoraadsen.nl, donker met goud.
   Staat los van Base.astro en de ontwerptokens van de huidige site, zodat een
   keuze voor of tegen een voorbeeld niets aan de live pagina verandert. */
import { Image } from 'astro:assets';
import Tekst from '../components/Tekst.astro';

import hellingFoto from '../images/helling-omhoog.jpg';
import krattenFoto from '../images/kratten-toren.jpg';
import kindFoto from '../images/kind-begeleid.jpg';
import bandFoto from '../images/band-paal.jpg';
import terreinFoto from '../images/terrein.jpg';
import veldFoto from '../images/community-veld.jpg';
import centrumTerrein from '../images/centrum-terrein.jpg';
import centrumVijver from '../images/centrum-vijver.jpg';
import centrumKring from '../images/centrum-kring.jpg';
import centrumGrasveld from '../images/centrum-grasveld.jpg';

interface Props {
  t: any;
  thema: 'licht' | 'onno';
}
const { t, thema } = Astro.props;

const voorbeelden = [
  { href: '/voorbeeld-licht/', naam: 'Voorbeeld 1: licht', code: 'licht' },
  { href: '/voorbeeld-onno/', naam: 'Voorbeeld 2: stijl onnoraadsen.nl', code: 'onno' },
  { href: '/', naam: 'Huidige site', code: 'huidig' },
];
const centrumBeelden = [centrumTerrein, centrumVijver, centrumKring, centrumGrasveld];
const tierKleur = ['var(--tier-1)', 'var(--tier-2)', 'var(--tier-3)'];
const nr = (i: number) => String(i + 1).padStart(2, '0');
---

<!doctype html>
<html lang="nl" data-thema={thema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`MAIS ESPORTE · ${thema === 'licht' ? 'Voorbeeld licht' : 'Voorbeeld stijl onnoraadsen.nl'}`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Wisselbalk: alleen voor de keuze, hoort niet bij het ontwerp. -->
    <div class="wissel">
      <span>Stijlvoorbeeld</span>
      <nav aria-label="Voorbeelden">
        {voorbeelden.map((v) => (
          <a href={v.href} aria-current={v.code === thema ? 'page' : undefined}>{v.naam}</a>
        ))}
      </nav>
    </div>

    <header class="kop">
      <div class="rij kop__rij">
        <a href="#top" class="logo" aria-label="MAIS ESPORTE">
          <svg viewBox="0 0 48 44" aria-hidden="true">
            <path d="M4 38 L18 16 L26 27 L32 19 L44 38 Z" fill="currentColor" opacity="0.9" />
            <path d="M24 1 L26.6 9.4 L35 12 L26.6 14.6 L24 23 L21.4 14.6 L13 12 L21.4 9.4 Z" fill="currentColor" />
            <circle cx="24" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.65" />
          </svg>
          <span>MAIS ESPORTE</span>
        </a>
        <nav class="menu" aria-label="Secties">
          {t.nav.items.map((i) => <a href={i.href}>{i.label}</a>)}
        </nav>
        <a href="#contact" class="knop knop--goud knop--klein">{t.nav.actie}</a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="top" class="hero">
        {thema === 'onno' && (
          <div class="hero__beeld">
            <Image src={hellingFoto} alt="" widths={[800, 1100]} sizes="100vw" loading="eager" />
          </div>
        )}
        <div class="rij hero__rij">
          <div class="hero__tekst">
            <p class="kicker">MAIS ESPORTE · an international movement</p>
            <h1 class="hero__kop">{t.hero.kop}<span class="goud">{t.hero.kopCursief}</span></h1>
            <span class="haar" aria-hidden="true"></span>
            <p class="hero__intro">{t.hero.inleiding}</p>
            <p class="hero__geloof">{t.hero.geloof}</p>
            <div class="knoppen">
              <a href="#contact" class="knop knop--goud">{t.hero.actie}</a>
              <a href="#aanpak" class="knop knop--lijn">{t.hero.actieTweede}</a>
            </div>
          </div>
          {thema === 'licht' && (
            <figure class="hero__foto">
              <Image src={hellingFoto} alt={t.hero.foto.alt} widths={[500, 800, 1100]} sizes="(max-width: 60rem) 90vw, 40vw" loading="eager" />
            </figure>
          )}
        </div>
      </section>

      <!-- Waarom -->
      <section class="blok blok--midden">
        <div class="rij smal">
          <h2 class="titel">{t.waarom.kop}</h2>
          <span class="haar" aria-hidden="true"></span>
          <p class="lead">{t.waarom.inleiding}</p>
          <p class="sub">{t.waarom.gevolgenKop}:</p>
          <ul class="gevolgen">
            {t.waarom.gevolgen.map((g, i) => <li><span class="nr">{nr(i)}</span>{g}</li>)}
          </ul>
        </div>
      </section>

      <section class="band">
        <Image src={veldFoto} alt="" widths={[800]} sizes="100vw" class="band__beeld" />
        <div class="rij smal band__tekst">
          <p class="citaat">{t.waarom.keerpunt}</p>
        </div>
      </section>

      <!-- Missie -->
      <section id="missie" class="blok blok--alt">
        <div class="rij twee">
          <div>
            <p class="kicker">{t.nav.items[0].label}</p>
            <h2 class="titel titel--links">{t.visie.kop}</h2>
            <span class="haar haar--links" aria-hidden="true"></span>
            <p class="lead lead--links">{t.visie.inleiding}</p>
            <ul class="stippen">
              {t.visie.onderdelen.map((o) => <li>{o}</li>)}
            </ul>
            <p class="slot">{t.visie.slot}</p>
          </div>
          <figure class="foto">
            <Image src={terreinFoto} alt={t.visie.foto.alt} widths={[500, 900]} sizes="(max-width: 60rem) 90vw, 45vw" />
            <figcaption>{t.visie.foto.plaat}</figcaption>
          </figure>
        </div>
      </section>

      <!-- Jongeren leiden jongeren -->
      <section id="aanpak" class="blok">
        <div class="rij">
          <div class="smal midden">
            <p class="kicker">{t.nav.items[1].label}</p>
            <h2 class="titel">{t.lus.kop}</h2>
            <span class="haar" aria-hidden="true"></span>
            <p class="lead">{t.lus.inleiding}</p>
          </div>
          <div class="lus">
            {t.lus.panelen.map((p, i) => (
              <article class="kaart lus__kaart">
                <span class="nr nr--groot">{nr(i)}</span>
                <Image src={i === 0 ? krattenFoto : kindFoto} alt={p.foto.alt} widths={[400, 700]} sizes="(max-width: 50rem) 90vw, 45vw" class="lus__beeld" />
                <p class="lus__zin">{p.bijschrift}</p>
                <p class="onderschrift">{p.foto.plaat}</p>
              </article>
            ))}
          </div>
          <p class="lus__sluit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {t.lus.sluit}
          </p>
        </div>
      </section>

      <!-- Leren door te doen -->
      <section id="methode" class="blok blok--alt">
        <div class="rij twee">
          <div>
            <h2 class="titel titel--links">{t.aanpak.kop}</h2>
            <span class="haar haar--links" aria-hidden="true"></span>
            <ul class="chips">
              {t.aanpak.onderdelen.map((o) => <li>{o}</li>)}
            </ul>
            <h3 class="kleinkop">{t.aanpak.bewijsKop}</h3>
            <p class="tekst"><Tekst delen={t.aanpak.bewijs} /></p>
            <p class="slot">{t.aanpak.slot}</p>
          </div>
          <figure class="foto foto--hoog">
            <Image src={bandFoto} alt={t.aanpak.foto.alt} widths={[400, 700]} sizes="(max-width: 60rem) 90vw, 40vw" />
            <figcaption>{t.aanpak.foto.plaat}</figcaption>
          </figure>
        </div>
        <div class="rij">
          <h3 class="kleinkop kleinkop--ruim">{t.aanpak.uniekKop}</h3>
          <div class="nummers">
            {t.aanpak.uniek.map((u, i) => (
              <div class="kaart nummer">
                <span class="nr nr--groot">{nr(i)}</span>
                <p>{u}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Opleidingscentrum -->
      <section id="opleidingscentrum" class="blok">
        <div class="rij twee twee--tekst">
          <div>
            <p class="kicker">Vale da Serra · Maranguape</p>
            <h2 class="titel titel--links">{t.centrum.kop}</h2>
            <span class="haar haar--links" aria-hidden="true"></span>
            <p class="lead lead--links">{t.centrum.inleiding}</p>
          </div>
          <div>
            {t.centrum.alineas.map((a) => <p class="tekst">{a}</p>)}
          </div>
        </div>
        <div class="rij galerij">
          {t.centrum.fotos.map((f, i) => (
            <figure class={`galerij__item galerij__item--${i + 1}`}>
              <Image src={centrumBeelden[i]} alt={f.alt} widths={[500, 900]} sizes="(max-width: 50rem) 90vw, 50vw" quality={66} />
              <figcaption>{f.plaat}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- Impact -->
      <section id="impact" class="blok blok--impact">
        <div class="rij">
          <div class="smal midden">
            <p class="kicker">{t.nav.items[3].label}</p>
            <h2 class="titel">{t.doelen.kop}</h2>
            <span class="haar" aria-hidden="true"></span>
          </div>
          <ol class="stats">
            {t.doelen.lijst.map((d) => (
              <li>
                <span class="stat__getal">{d.getal}</span>
                <span class="stat__eenheid">{d.eenheid}</span>
                <span class="stat__tekst">{Array.isArray(d.tekst) ? <Tekst delen={d.tekst} /> : d.tekst}</span>
              </li>
            ))}
          </ol>
          <p class="noot noot--midden">{t.doelen.waarschuwing}</p>
          <p class="sub sub--midden">{t.doelen.daarnaastKop}</p>
          <ul class="chips chips--midden">
            {t.doelen.daarnaast.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </section>

      <!-- Word partner -->
      <section id="partner" class="blok">
        <div class="rij">
          <div class="smal midden">
            <p class="kicker">{t.nav.items[4].label}</p>
            <h2 class="titel">{t.partner.kop}</h2>
            <span class="haar" aria-hidden="true"></span>
            <p class="lead">{t.partner.inleiding}</p>
          </div>
          <h3 class="kleinkop kleinkop--midden">{t.partner.bordenKop}</h3>
          <div class="tiers">
            {t.partner.borden.map((b, i) => (
              <article class="kaart tier" style={`--tier:${tierKleur[i]}`}>
                <div class="tier__kop">
                  <span class="nr">{nr(i)}</span>
                  <h4 class="tier__naam">{b.naam}</h4>
                  <p class="tier__werkwoord">{b.werkwoord}</p>
                  <p class="tier__bedrag">{b.bedrag}</p>
                  <p class="tier__voor">{b.voor}</p>
                </div>
                <div class="tier__inhoud">
                  {b.basis && <p class="tier__basis">{b.basis}</p>}
                  <ul class="stippen stippen--klein">
                    {b.punten.map((p) => <li>{Array.isArray(p) ? <Tekst delen={p} /> : p}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
          <div class="overzicht">
            <p class="noot">{t.partner.overzicht.tekst}</p>
            <a href={t.partner.overzicht.bestand} class="knop knop--lijn" target="_blank" rel="noopener noreferrer">{t.partner.overzicht.naam}</a>
          </div>

          <div class="twee twee--onder">
            <div class="kaart begin">
              <p class="kicker">{t.partner.beginKop}</p>
              <p class="tekst">{t.partner.begin}</p>
              <p class="begin__prijs">{t.partner.beginPrijs}</p>
              <p class="noot">{t.partner.beginPrijsNoot}</p>
            </div>
            <div>
              <h3 class="kleinkop">{t.partner.biedtKop}</h3>
              <ul class="stippen">
                {t.partner.biedt.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Niet vanaf de zijlijn -->
      <section class="blok blok--alt">
        <div class="rij twee">
          <figure class="foto">
            <Image src={veldFoto} alt={t.ervaring.foto.alt} widths={[500, 800]} sizes="(max-width: 60rem) 90vw, 45vw" />
            <figcaption>{t.ervaring.foto.plaat}</figcaption>
          </figure>
          <div>
            <h2 class="titel titel--links">{t.ervaring.kop}</h2>
            <span class="haar haar--links" aria-hidden="true"></span>
            <p class="lead lead--links">{t.ervaring.inleiding}</p>
            <ul class="stippen stippen--twee">
              {t.ervaring.vormen.map((v) => <li>{v}</li>)}
            </ul>
            <p class="slot">{t.ervaring.slot}</p>
          </div>
        </div>
      </section>

      <!-- Documenten -->
      <section class="blok blok--midden">
        <div class="rij smal">
          <h2 class="titel">{t.documenten.kop}</h2>
          <span class="haar" aria-hidden="true"></span>
          <p class="lead">{t.documenten.inleiding}</p>
          <div class="knoppen knoppen--midden">
            {t.documenten.items.map((item, i) => (
              <a href={item.bestand ?? item.mail} class={`knop ${i === 0 ? 'knop--goud' : 'knop--lijn'}`} {...(item.bestand ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.naam}</a>
            ))}
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="contact">
        <div class="rij smal">
          <h2 class="titel">{t.contact.kop}</h2>
          <span class="haar" aria-hidden="true"></span>
          <p class="lead">{t.contact.inleiding}</p>
          <p class="contact__uitnodiging">{t.contact.uitnodiging}</p>
          <div class="knoppen knoppen--midden">
            <a href={t.contact.actieMail} class="knop knop--goud">{t.contact.actie}</a>
            <a href={t.contact.actieWhatsapp} class="knop knop--lijn" target="_blank" rel="noopener noreferrer">{t.contact.actieTweede}</a>
          </div>
          <dl class="gegevens">
            {t.contact.gegevens.map((g) => (
              <div><dt>{g.label}</dt><dd><a href={g.href}>{g.tekst}</a></dd></div>
            ))}
          </dl>
        </div>
      </section>
    </main>

    <footer class="voet">
      <div class="rij voet__rij">
        <div>
          <p class="logo logo--voet">MAIS ESPORTE</p>
          <p class="noot">{t.merk.coordinaten}</p>
        </div>
        <div>
          <p class="voet__kop">{t.voet.websitesKop}</p>
          <ul>
            {t.voet.websites.map((w) => <li><a href={w.href} target="_blank" rel="noopener noreferrer">{w.tekst}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="voet__kop">Contact</p>
          <ul>
            {t.contact.gegevens.map((g) => <li><a href={g.href}>{g.tekst}</a></li>)}
          </ul>
        </div>
      </div>
    </footer>

    <script>
      // Rustig invliegen van blokken, zoals op onnoraadsen.nl. Niet bij
      // prefers-reduced-motion, en zonder JavaScript staat alles gewoon.
      const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!stil && 'IntersectionObserver' in window) {
        const doelen = document.querySelectorAll('.titel, .lead, .kaart, .foto, .galerij__item, .stats li');
        doelen.forEach((el) => el.classList.add('vlieg'));
        const kijker = new IntersectionObserver((regels) => {
          for (const r of regels) if (r.isIntersecting) { r.target.classList.add('vlieg--in'); kijker.unobserve(r.target); }
        }, { threshold: 0.12 });
        doelen.forEach((el) => kijker.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  /* ── Thema's ─────────────────────────────────────────────── */
  [data-thema='onno'] {
    --bg: #1a1a1a;
    --bg-alt: #232323;
    --kaart: rgba(61, 61, 61, 0.55);
    --rand: rgba(212, 168, 75, 0.2);
    --rand-sterk: rgba(212, 168, 75, 0.55);
    --tekst: #faf8f5;
    --tekst-zacht: rgba(250, 248, 245, 0.72);
    --kop: #d4a84b;
    --goud: #d4a84b;
    --goud-tekst: #d4a84b;
    --op-goud: #1a1a1a;
    --kopbalk: rgba(26, 26, 26, 0.94);
    --impact-bg: linear-gradient(180deg, #1a1a1a, rgba(61, 61, 61, 0.7), #1a1a1a);
    --contact-bg: #232323;
    --tier-1: #d4a84b;
    --tier-2: #9caf88;
    --tier-3: #c87b5a;
    --band-overlay: rgba(26, 26, 26, 0.68);
  }
  [data-thema='licht'] {
    --bg: #faf8f5;
    --bg-alt: #f1ede5;
    --kaart: #ffffff;
    --rand: rgba(184, 144, 61, 0.22);
    --rand-sterk: rgba(184, 144, 61, 0.6);
    --tekst: #2b2b2b;
    --tekst-zacht: #635d53;
    --kop: #1a1a1a;
    --goud: #d4a84b;
    --goud-tekst: #9a7426;
    --op-goud: #1a1a1a;
    --kopbalk: rgba(250, 248, 245, 0.95);
    --impact-bg: #eef1e9;
    --contact-bg: #1a1a1a;
    --tier-1: #d4a84b;
    --tier-2: #7f9a6c;
    --tier-3: #c87b5a;
    --band-overlay: rgba(26, 26, 26, 0.55);
  }

  /* ── Basis ───────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 6rem; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--tekst);
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4, p, ul, ol, dl, dd, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--goud); outline-offset: 3px; }

  .rij { width: min(100% - 3rem, 75rem); margin-inline: auto; }
  .smal { max-width: 52rem; }
  .midden, .blok--midden .rij, .contact .rij { text-align: center; }
  .goud { color: var(--goud); }

  /* Koppen: Bebas Neue, zoals onnoraadsen.nl */
  .titel, .hero__kop, .kleinkop, .tier__naam, .stat__getal, .citaat, .logo, .nr--groot, .lus__zin, .slot, .begin__prijs, .tier__bedrag {
    font-family: 'Bebas Neue', 'Montserrat', sans-serif;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .titel {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--kop);
  }
  .kleinkop { font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.05; color: var(--kop); margin-top: 2.5rem; }
  .kleinkop--ruim { margin-top: 4rem; }
  .kleinkop--midden { text-align: center; margin-top: 4rem; }
  .kicker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--goud-tekst);
    margin-bottom: 1rem;
  }
  .haar {
    display: block;
    width: 6rem;
    height: 2px;
    margin: 1.75rem auto;
    background: linear-gradient(90deg, transparent, var(--goud), transparent);
  }
  .haar--links { margin-left: 0; background: var(--goud); width: 4rem; }
  .lead { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.6; color: var(--tekst-zacht); font-weight: 300; }
  .lead--links { text-align: left; }
  .tekst { color: var(--tekst-zacht); margin-top: 1rem; }
  .sub { margin-top: 2.5rem; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--goud-tekst); }
  .noot { font-size: 0.85rem; color: var(--tekst-zacht); }
  .noot--midden, .sub--midden { text-align: center; }
  .slot { margin-top: 2rem; font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.1; color: var(--goud-tekst); }
  .nr { font-size: 0.8rem; letter-spacing: 0.2em; color: var(--goud-tekst); font-weight: 600; }
  .nr--groot { font-size: 2.6rem; letter-spacing: 0; color: var(--goud); opacity: 0.55; line-height: 1; }

  .kaart {
    background: var(--kaart);
    border: 1px solid var(--rand);
    border-radius: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    transition: border-color 0.3s;
  }
  .kaart:hover { border-color: var(--rand-sterk); }
